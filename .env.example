# Secrets live in your environment, never in config.toml or any file in this repo.
# This file lists the NAMES only. To use it: copy to .env, fill in real values, and keep .env
# private (it is already in .gitignore). The names must match the "...Env" settings in config.toml.
# Bun reads this file by itself when you run a command in the project folder. Write NAME=value with
# no quotes and no spaces. Only the chat app you chose needs its lines: leave the others empty or
# delete them (bun run doctor only checks the chat app you chose).

# The model (always needed). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Telegram: the bot token from @BotFather (needed when messaging.platform = "telegram",
# or when alerts.channel = "telegram").
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# WhatsApp Cloud API, beta (needed when messaging.platform = "whatsapp").
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
WHATSAPP_APP_SECRET=your-whatsapp-app-secret-here
WHATSAPP_VERIFY_TOKEN=a-passphrase-you-choose-here

# iMessage through a BlueBubbles server, beta (needed when messaging.platform = "imessage").
BLUEBUBBLES_PASSWORD=your-bluebubbles-password-here
